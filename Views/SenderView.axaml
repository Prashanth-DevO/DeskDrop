<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="AvaloniaFileTransfer.Views.SenderView"
        Title="Send Files"
        Width="640"
        Height="620"
        MinWidth="580"
        MinHeight="520"
        WindowStartupLocation="CenterOwner"
        Background="#F0F3F6">

    <Grid RowDefinitions="Auto,*">

        <!-- HEADER -->
        <Border Grid.Row="0"
                Background="#F7F9FB"
                BorderBrush="#D3DAE2"
                BorderThickness="0,0,0,1"
                Padding="16,12">

            <Grid ColumnDefinitions="*,Auto,*">

                <Button Content="← Back"
                        Grid.Column="0"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="#222222"
                        FontSize="15"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Cursor="Hand"
                        Click="Back_Click"/>

                <TextBlock Grid.Column="1"
                           Text="Send Files"
                           FontSize="21"
                           FontWeight="SemiBold"
                           Foreground="#111111"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center"/>

            </Grid>
        </Border>


        <!-- MAIN CONTENT -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">

            <StackPanel Margin="28,16,28,20"
                        Spacing="14">

                <!-- SECTION 1 -->
                <TextBlock Text="1. SELECT FILES"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Foreground="#171717"/>

                <!-- File drop area -->
                <Border x:Name="FileDropBorder"
                        Background="#E8EEF2"
                        BorderBrush="#A8B4BE"
                        BorderThickness="1"
                        CornerRadius="5"
                        Padding="16,20"
                        MinHeight="100"
                        DragDrop.AllowDrop="True">

                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Spacing="10">

                        <TextBlock x:Name="DropHintText"
                                   Text="Drop files or folders here, or browse your computer"
                                   FontSize="16"
                                   Foreground="#334155"
                                   HorizontalAlignment="Center"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"/>

                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    Spacing="12">

                            <Button Content="[ + Add Files ]"
                                    Background="#0875C9"
                                    Foreground="White"
                                    BorderBrush="#0868B1"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="14,7"
                                    FontSize="14"
                                    Cursor="Hand"
                                    Click="AddFiles_Click"/>

                            <Button Content="[ + Add Folder ]"
                                    Background="#0875C9"
                                    Foreground="White"
                                    BorderBrush="#0868B1"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="14,7"
                                    FontSize="14"
                                    Cursor="Hand"
                                    Click="AddFolder_Click"/>

                        </StackPanel>
                    </StackPanel>
                </Border>


                <!-- SELECTED FILES HEADER -->
                <Grid ColumnDefinitions="*,Auto,Auto"
                      Margin="0,4,0,-4">

                    <TextBlock Text="Selected Files"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="#222222"
                               VerticalAlignment="Center"/>

                    <TextBlock x:Name="FileSummary"
                               Grid.Column="1"
                               Text="0 files · 0 B"
                               FontSize="13"
                               Foreground="#555555"
                               VerticalAlignment="Center"
                               Margin="0,0,12,0"/>

                    <Button x:Name="ClearAllButton"
                            Grid.Column="2"
                            Content="Clear All"
                            Background="Transparent"
                            Foreground="#D93636"
                            BorderThickness="0"
                            FontSize="12"
                            Cursor="Hand"
                            IsVisible="False"
                            Click="ClearAll_Click"/>

                </Grid>


                <!-- SELECTED FILES LIST CONTAINER -->
                <Border Background="#FFFFFF"
                        BorderBrush="#BCC6D0"
                        BorderThickness="1"
                        CornerRadius="4"
                        MinHeight="90"
                        MaxHeight="220">

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <!-- List items -->
                            <StackPanel x:Name="SelectedFilesList"/>

                            <!-- Empty state -->
                            <StackPanel x:Name="EmptyFilesPanel"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Margin="16,24"
                                        Spacing="4">
                                <TextBlock Text="📁"
                                           FontSize="22"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="No files selected yet."
                                           FontSize="13"
                                           Foreground="#8898AA"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Border>


                <!-- SECTION 2 -->
                <TextBlock Text="2. RECEIVER DETAILS"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Foreground="#171717"
                           Margin="0,6,0,0"/>

                <Grid ColumnDefinitions="*,*"
                      ColumnSpacing="14">

                    <StackPanel Grid.Column="0"
                                Spacing="4">

                        <TextBlock Text="Receiver IP Address"
                                   FontSize="13"
                                   FontWeight="Medium"
                                   Foreground="#222222"/>

                        <TextBox x:Name="ReceiverIpTextBox"
                                 Text="192.168.1.10"
                                 PlaceholderText="e.g. 192.168.1.10"
                                 FontSize="14"
                                 Padding="8,6"
                                 Background="#FFFFFF"
                                 BorderBrush="#C6CED6"
                                 CornerRadius="4"/>

                    </StackPanel>

                    <StackPanel Grid.Column="1"
                                Spacing="4">

                        <TextBlock Text="Receiver Port"
                                   FontSize="13"
                                   FontWeight="Medium"
                                   Foreground="#222222"/>

                        <TextBox x:Name="PortTextBox"
                                 Text="8080"
                                 FontSize="14"
                                 Padding="8,6"
                                 Background="#FFFFFF"
                                 BorderBrush="#C6CED6"
                                 CornerRadius="4"/>

                    </StackPanel>

                </Grid>


                <!-- SECTION 3 -->
                <TextBlock Text="3. TRANSFER"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Foreground="#171717"
                           Margin="0,6,0,0"/>

                <Border Background="#FFFFFF"
                        BorderBrush="#D3DAE2"
                        BorderThickness="1"
                        CornerRadius="5"
                        Padding="16">
                    <StackPanel Spacing="12">

                        <TextBlock x:Name="TransferStatusText"
                                   Text="Status: Ready"
                                   FontSize="14"
                                   Foreground="#333333"/>

                        <!-- Progress -->
                        <Grid ColumnDefinitions="Auto,*,Auto"
                              ColumnSpacing="8">

                            <TextBlock Text="Progress"
                                       FontSize="13"
                                       Foreground="#444444"
                                       VerticalAlignment="Center"/>

                            <ProgressBar x:Name="TransferProgressBar"
                                         Grid.Column="1"
                                         Minimum="0"
                                         Maximum="100"
                                         Value="0"
                                         Height="16"
                                         VerticalAlignment="Center"/>

                            <TextBlock x:Name="ProgressPercentageText"
                                       Grid.Column="2"
                                       Text="0%"
                                       FontSize="13"
                                       Foreground="#444444"
                                       VerticalAlignment="Center"/>

                        </Grid>

                        <!-- Action Buttons -->
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    Spacing="12"
                                    Margin="0,4,0,0">

                            <Button x:Name="StartTransferButton"
                                    Content="[ Start Transfer ]"
                                    Background="#0875C9"
                                    Foreground="White"
                                    BorderBrush="#0868B1"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    FontSize="14"
                                    FontWeight="SemiBold"
                                    Padding="16,8"
                                    Cursor="Hand"
                                    Click="StartTransfer_Click"/>

                            <Button x:Name="CancelTransferButton"
                                    Content="[ Cancel ]"
                                    Background="#D93636"
                                    Foreground="White"
                                    BorderBrush="#B82828"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    FontSize="14"
                                    FontWeight="SemiBold"
                                    Padding="16,8"
                                    Cursor="Hand"
                                    IsEnabled="False"
                                    Click="CancelTransfer_Click"/>

                        </StackPanel>

                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

    </Grid>
</Window>